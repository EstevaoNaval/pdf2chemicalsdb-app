# pdf2chemicals Celery worker on Rocky Linux 9.
# Select it with PDF2CHEMICALS_WORKER_DOCKERFILE=Dockerfile.rocky.
# Rocky is the RHEL-family fallback. It is not the PBS host OS, and it is not
# on the Torque 6.1.3 vendor support list (that list stops at CentOS/RHEL 7).
# Build context is api/. Input: vendor/torque-6.1.3.tar.gz and the API tree.
# Output: root entrypoint starts trqauthd, then Celery runs as the service user.

ARG ROCKY_VERSION=9
ARG TORQUE_VERSION=6.1.3

###############################################################################
# Torque 6.1.3 clients package.
###############################################################################
FROM rockylinux:${ROCKY_VERSION} AS torque
ARG TORQUE_VERSION
ARG TORQUE_SHA256=""

RUN dnf -y --setopt=install_weak_deps=False install \
      gcc gcc-c++ make libtool autoconf automake pkgconf-pkg-config which tar gzip \
      flex bison \
      openssl-devel libxml2-devel zlib-devel boost-devel \
 && dnf clean all

WORKDIR /src
COPY vendor/torque-${TORQUE_VERSION}.tar.gz /src/

# Plain make: parallel Torque builds are unreliable.
# --disable-gcc-warnings: a newer gcc warns on this 2018 tree and the default is to fail.
# ac_cv_lib_pthread_pthread_create: Torque sets CC=g++ before the pthread probe.
# sed: a tarball packed from a Windows git checkout has CRLF, which breaks autogen.sh.
RUN if [ -n "${TORQUE_SHA256}" ]; then \
      echo "${TORQUE_SHA256}  torque-${TORQUE_VERSION}.tar.gz" | sha256sum -c -; \
    fi \
 && tar xzf torque-${TORQUE_VERSION}.tar.gz \
 && find torque-${TORQUE_VERSION} -type f -not -path '*/.git/*' -exec sed -i 's/\r$//' {} + \
 && cd torque-${TORQUE_VERSION} \
 && { [ -x ./configure ] || ./autogen.sh; } \
 && ac_cv_lib_pthread_pthread_create=yes \
      ./configure --prefix=/usr/local --with-server-home=/var/spool/torque \
      --disable-server --disable-mom --disable-gcc-warnings \
 && make \
 && make packages \
 && cp torque-package-clients-linux-*.sh /src/torque-clients.sh

###############################################################################
# Runtime. No USER: the entrypoint needs root for trqauthd, then gosu.
###############################################################################
FROM rockylinux:${ROCKY_VERSION}

ARG SVC_USER=svc_pdf2chemicals_prod
ARG SVC_UID
ARG SVC_GID
ARG DATA_GID
ARG DATA_GROUP
ARG GOSU_VERSION=1.17
ARG PYTHON_PKG=python3.12

ENV SVC_USER=${SVC_USER} \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:/usr/local/sbin:/usr/local/bin:${PATH}"

RUN dnf -y --setopt=install_weak_deps=False install \
      openssl-libs libxml2 zlib ${PYTHON_PKG} ${PYTHON_PKG}-pip curl ca-certificates \
 && dnf clean all

# gosu is not in the Rocky repos. The entrypoint calls it by name.
RUN curl -fsSL -o /usr/local/bin/gosu \
      "https://github.com/tianon/gosu/releases/download/${GOSU_VERSION}/gosu-$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')" \
 && chmod +x /usr/local/bin/gosu \
 && gosu --version

COPY --from=torque /src/torque-clients.sh /tmp/torque-clients.sh
RUN chmod +x /tmp/torque-clients.sh \
 && /tmp/torque-clients.sh --install \
 && rm -f /tmp/torque-clients.sh \
 && echo /usr/local/lib > /etc/ld.so.conf.d/torque.conf \
 && ldconfig \
 && mkdir -p /var/spool/torque

RUN set -e; \
    for b in qsub qstat qdel pbsnodes trqauthd; do \
      p="$(command -v "$b")" || { echo "ERROR: $b not found in PATH"; exit 1; }; \
      if ldd "$p" | grep -q "not found"; then echo "ERROR: missing libs for $b"; ldd "$p"; exit 1; fi; \
      echo "OK: $p"; \
    done

# Primary group is torque_queue_batch (SVC_GID). Data group is supplementary.
RUN groupadd -g ${SVC_GID} torque_queue_batch \
 && groupadd -g ${DATA_GID} ${DATA_GROUP} \
 && useradd -m -u ${SVC_UID} -g torque_queue_batch -G ${DATA_GROUP} \
      -s /sbin/nologin ${SVC_USER}

RUN ${PYTHON_PKG} -m venv ${VIRTUAL_ENV}
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt

WORKDIR /src
COPY . .
RUN rm -rf /src/vendor

COPY scripts/docker-pdf2chemicals-worker-entrypoint.sh /usr/local/bin/docker-pdf2chemicals-worker-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/docker-pdf2chemicals-worker-entrypoint.sh \
 && chmod +x /usr/local/bin/docker-pdf2chemicals-worker-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/docker-pdf2chemicals-worker-entrypoint.sh"]
CMD ["celery", "-A", "labsoa_website_backend", "worker", "--queues=pdf2chemicals_tasks", "--prefetch-multiplier=1", "--autoscale=3,0", "--max-tasks-per-child=1", "--loglevel=INFO"]
